{
  "name": "bakong-notification-service",
  "version": "1.0.0",
  "description": "Bakong Notification Service",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/packages/*"
  ],
  "scripts": {
    "dev": "cd apps/backend && npm run dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build": "npm run build:shared && cd apps/backend && npm run build && cd ../frontend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "build:shared": "cd apps/packages/shared && npm run build",
    "build:all": "npm run build:shared && npm run build && npm run build:frontend",
    "build:prod": "cross-env NODE_ENV=production npx nest build",
    "start": "cd apps/backend && npm run start",
    "format": "prettier --write \"**/*.{ts,js,vue,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,vue,json,md}\"",
    "type-check": "npm run build:shared && cd apps/backend && npm run type-check && cd ../frontend && npm run type-check && cd ../packages/shared && npm run type-check",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:up:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:up:dev:detached": "docker-compose -f docker-compose.dev.yml up -d --build",
    "docker:down:dev": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs:dev": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:restart:dev": "docker-compose -f docker-compose.dev.yml restart",
    "docker:up:sit": "docker-compose -f docker-compose.sit.yml up -d --build",
    "docker:down:sit": "docker-compose -f docker-compose.sit.yml down",
    "docker:logs:sit": "docker-compose -f docker-compose.sit.yml logs -f",
    "docker:up:prod": "docker-compose -f docker-compose.production.yml up -d --build",
    "docker:down:prod": "docker-compose -f docker-compose.production.yml down",
    "docker:logs:prod": "docker-compose -f docker-compose.production.yml logs -f",
    "test:deploy:local": "bash test-deploy-local.sh",
    "test:deploy:local:up": "bash test-deploy-local.sh --up",
    "clean": "cd apps/backend && npm run prebuild && cd ../frontend && rm -rf dist",
    "fix": "npm run format",
    "fix:check": "npm run format:check",
    "update:project-structure": "node .cursor/scripts/update-project-structure.js"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.14",
    "@types/babel__core": "^7.20.5",
    "@types/babel__template": "^7.4.4",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.1.0",
    "@types/graceful-fs": "^4.1.9",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.11.29",
    "@types/multer": "^2.0.0",
    "@types/parse-json": "^4.0.2",
    "@types/passport": "^1.0.17",
    "@types/qs": "^6.14.0",
    "@types/range-parser": "^1.2.7",
    "@types/serve-static": "^1.15.9",
    "@types/sharp": "^0.31.1",
    "@types/stack-utils": "^2.0.3",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "jest": "^30.2.0",
    "localtunnel": "^2.0.2",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@nestjs/core": "^11.1.14",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.14",
    "bcrypt": "^6.0.0",
    "class-validator": "0.14.3",
    "element-plus": "^2.11.4",
    "firebase-admin": "^13.6.1",
    "lucide-vue-next": "^0.545.0",
    "luxon": "^3.7.2",
    "moment": "^2.30.1",
    "nestjs": "^0.0.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.18.0",
    "pinia": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.10",
    "u": "^0.1.0"
  }
}
