{
  "name": "bakong-notification-services",
  "version": "0.0.1",
  "description": "Bakong Notification Service for announcement",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node fix-paths.js",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\"",
    "lint": "eslint \"src/**/*.{ts,js}\" --fix",
    "format:all": "npm run format && npm run lint",
    "start": "node dist/main",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:staging": "cross-env NODE_ENV=staging nest start",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "build:dev": "cross-env NODE_ENV=development nest build",
    "build:staging": "cross-env NODE_ENV=staging nest build",
    "build:prod": "cross-env NODE_ENV=production nest build",
    "lint:check": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js --dataSource ./src/ormconfig.ts",
    "remove-duplicates": "ts-node -r tsconfig-paths/register scripts/remove-duplicate-images.ts",
    "fix-null-fileid": "ts-node -r tsconfig-paths/register scripts/fix-null-fileid.ts",
    "migrate:fix-enums": "docker exec -i bakong-notification-services-db-dev psql -U bkns_dev -d bakong_notification_services_dev < scripts/fix-enum-values-realtime.sql",
    "migrate:fix-enums:local": "psql -h localhost -p 5437 -U bkns_dev -d bakong_notification_services_dev -f scripts/fix-enum-values-realtime.sql",
    "start:dev-tunnel": "NODE_ENV=development npx localtunnel --port 4002 --subdomain bakong-notification-services"
  },
  "dependencies": {
    "@bakong/shared": "file:../packages/shared",
    "@nestjs/common": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "@nestjs/core": "^11.1.14",
    "tsc-alias": "^1.8.16"
  }
}
